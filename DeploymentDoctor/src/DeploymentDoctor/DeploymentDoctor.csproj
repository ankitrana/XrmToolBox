<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeploymentDoctor</RootNamespace>
    <AssemblyName>DeploymentDoctor</AssemblyName>
    <!-- Bump on every deploy: XrmToolBox caches plugin scans by file name + version (Plugins\manifest.json) -->
    <Version>0.3.2</Version>
    <Authors>Ankit Rana</Authors>
    <Company>Ankit Rana</Company>
    <Product>Deployment Doctor</Product>
    <Description>XrmToolBox tool that explains why a change deployed with a managed solution does not show in the target environment, and helps fix it. Created by Ankit Rana.</Description>
    <Copyright>Copyright (c) 2026 Ankit Rana</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer for msdyn_componentjson (framework assembly, nothing extra to deploy) -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
